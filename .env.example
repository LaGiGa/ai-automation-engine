# ==============================================================================
# AI Automation Engine — Environment Variables Template
# Copy this file to .env.local and configure your credentials:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Extraction Providers (At least one is required)
# ------------------------------------------------------------------------------
# Gemini API Key (Recommended - fast, high token window, schema enforcement)
# Obtain your API key at: https://ai.google.dev or Google Cloud Console
GEMINI_API_KEY=

# OpenAI API Key (Alternative engine - Structured Outputs)
# Obtain your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Database & Persistence (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# If not configured, the application runs seamlessly using in-memory local state.
# Configure Supabase to enable PostgreSQL JSONB persistence across sessions:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Application URL (Webhooks & Base URL)
# ------------------------------------------------------------------------------
# Base URL for self-referencing API endpoints and webhook simulation:
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
